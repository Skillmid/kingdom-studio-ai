NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Text generation providers. Keep keys server-side; never expose with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Select openrouter (default) or gemini for screenplay and Story Bible AI features.
NEXT_PUBLIC_AI_DEFAULT_PROVIDER=openrouter
OPENROUTER_MODEL=
OPENROUTER_ALLOWED_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ALLOWED_MODELS=

OPENAI_API_KEY=
# OpenAI image model. Only URL-returning models work today:
#   dall-e-3 / dall-e-2 -> hosted URL, compatible with the URL-based asset architecture.
# If unset, the code default is gpt-image-1. gpt-image models return base64 only and are refused
# BEFORE any paid call, because durable media storage (e.g. Supabase Storage) is not implemented yet.
# OPENAI_IMAGE_MODEL=dall-e-3

# Leave Kling unset to keep jobs recoverable without inventing media URLs.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
